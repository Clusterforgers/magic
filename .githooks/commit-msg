#!/usr/bin/env bash
# Rejects AI attribution lines; runs fmt + clippy unless the message starts with "wip:".
set -euo pipefail
msg_file="$1"

if grep -qiE '^co-authored-by:.*(claude|anthropic)|generated with' "$msg_file"; then
  echo "commit rejected: remove AI attribution from the message" >&2
  exit 1
fi

case "$(head -n 1 "$msg_file")" in
  wip:*) exit 0 ;;
esac

"$(git rev-parse --show-toplevel)/scripts/check.sh" fast
