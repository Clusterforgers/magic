{
  "db_name": "PostgreSQL",
  "query": "SELECT m.oracle_id, c.name, m.note,\n                      to_char(m.created_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"') AS \"created_at!\"\n               FROM card_fix_marks m JOIN cards c ON c.oracle_id = m.oracle_id\n               WHERE m.user_id = $1 ORDER BY m.created_at DESC, c.name, m.oracle_id",
