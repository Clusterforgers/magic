  "query": "SELECT printing_id, images AS \"images: Json<PrintingImages>\"\n               FROM printings\n               WHERE oracle_id = $1 AND jsonb_path_exists(images, '$.** ? (@.type() == \"string\")')\n               ORDER BY digital, lang <> 'en', released_at DESC NULLS LAST, printing_id\n               LIMIT 1",
