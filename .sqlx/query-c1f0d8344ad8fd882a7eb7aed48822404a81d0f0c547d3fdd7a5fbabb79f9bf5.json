{
  "db_name": "PostgreSQL",
  "query": "SELECT d.oracle_id, d.read_hash, d.rules, d.retired, d.source, d.oracle_matches, d.proof, d.differs FROM card_drafts d\n             JOIN unnest($1::uuid[], $2::text[]) AS k(oracle_id, read_hash)\n               ON d.oracle_id = k.oracle_id AND d.read_hash = k.read_hash\n             ORDER BY d.oracle_id, d.created_at, d.read_hash",
