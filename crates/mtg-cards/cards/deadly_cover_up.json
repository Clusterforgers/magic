                    },
                    { "Exile": { "what": { "Bound": "found" }, "as": "exiled" } },
                    { "Shuffle": { "who": { "Bound": "owner" } } },
                    {
                      "Draw": {
                        "who": { "Bound": "owner" },
                        "count": {
                          "Count": [
                            { "Is": { "Bound": "exiled" } },
