                        "as": "cards"
                      }
                    },
                    {
                      "Discard": {
                        "who": { "Bound": "opp" },
                        "count": { "CountOf": { "of": { "Bound": "cards" }, "filter": [] } },
                        "filter": [{ "Is": { "Bound": "cards" } }]
                      }
                    },
                    {
                      "Draw": {
                        "who": { "Bound": "opp" },
                        "count": { "CountOf": { "of": { "Bound": "cards" }, "filter": [] } }
                      }
                    }
                  ]
                }
              },
              { "Search": { "filter": [], "count": { "min": 0, "max": 3 }, "as": "found" } },
              { "Move": { "what": { "Bound": "found" }, "to": "Hand" } },
              { "Shuffle": {} },
              { "Discard": { "count": 3, "random": true } }
            ]
          }
        }
      ]
    }
  ]
